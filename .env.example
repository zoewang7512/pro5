# 複製這個檔案為 .env.local 並填入真實值。
# 真實金鑰只存放在 Vercel 專案的環境變數設定，不得提交進版控。

# Supabase（見 Supabase 專案設定 > API）
# 前端可安全暴露的公開值：
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 僅限伺服器端使用，具完整權限，絕不可暴露於前端或版控：
SUPABASE_SERVICE_ROLE_KEY=

# Email 通知服務（Resend，用於預約確認信、取消/改期通知信、提醒信）
# EMAIL_API_KEY：Resend Dashboard 的 API key（re_ 開頭），僅限伺服器端使用。
# EMAIL_FROM_ADDRESS：寄件人地址，需為已在 Resend 完成網域驗證的地址。
EMAIL_API_KEY=
EMAIL_FROM_ADDRESS=

# Supabase Database Webhook 共用密鑰（TASK-052／053 用於驗證「確認信／取消改期通知信」
# 觸發請求確實來自 Supabase，而非任意第三方冒用端點網址發出的偽造請求）。
# 於 Supabase Dashboard 設定 Database Webhook 時，把同一組值填進自訂 header。
#
# 產生方式（擇一，需為高強度亂數字串，不得使用可猜測的字串）：
#   macOS/Linux： openssl rand -hex 32
#   跨平台（含 Windows，不依賴 openssl）： node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# 產生出來的值只會是 [0-9a-f] 的 hex 字元（純 ASCII）——密鑰請維持這個格式，不要手動
# 改成含中文或其他非 ASCII 字元的字串：HTTP header 在不同 runtime（Node http／
# undici fetch／Edge runtime）對非 ASCII 值的編碼處理不完全一致，可能造成間歇性、
# 難以除錯的驗證失敗（security-reviewer 於 TASK-051 審查提出）。
#
# 本專案只有一位設計師、一組後台，但仍**務必讓 SUPABASE_WEBHOOK_SECRET 與 CRON_SECRET
# 是兩組不同的值**：兩者保護不同的觸發路徑（資料庫事件 vs 排程），其中一組外洩不應該
# 連帶攻破另一條路徑。
SUPABASE_WEBHOOK_SECRET=

# Vercel Cron 共用密鑰（TASK-054 用於驗證排程觸發請求確實來自 Vercel Cron，而非任意
# 第三方對外可觸及的端點網址直接發出的偽造請求）。
# 於 Vercel 專案設定 Cron Job 時，Vercel 會自動在請求帶入
# `Authorization: Bearer <CRON_SECRET>`，這裡填的值需與 Vercel 專案環境變數的
# CRON_SECRET 一致；產生方式與格式要求同上（SUPABASE_WEBHOOK_SECRET），且必須是
# 與其不同的另一組值。
CRON_SECRET=

# 對外基底網址，用於組出 email 中的預約連結等絕對網址
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 唯一設計師帳號 seed 用（scripts/seed-designer-account.mjs 與 npm run test:rls 需要）。
# 只在本機 .env.local 填入實際值，密碼至少 12 碼；建立完成後可保留供 npm run test:rls 使用，
# 或清空只留變數名稱。
DESIGNER_EMAIL=
DESIGNER_PASSWORD=

# Demo 體驗帳戶（讓訪客一鍵進入後台體驗；架構見 ai/artifacts/Demo 體驗帳戶/architecture-notes.md）。
# 五個變數都只放伺服器環境，**絕不加 NEXT_PUBLIC_ 前綴**（加了就會被打包進瀏覽器）。
# **Vercel 環境變數改動後必須 Redeploy 才會生效**（緊急關閉不能只改變數，見營運手冊）。
#
# DEMO_ENABLED：入口與一鍵進入端點的總開關，只有 "true" 才啟用，預設關閉。
DEMO_ENABLED=false
# DEMO_EMAIL：Demo 帳戶的登入 Email，不得與 DESIGNER_EMAIL 相同（不分大小寫，相同時入口自動關閉）。
# **這個 Email 會顯示在帳號設定頁，等於公開**，所以必須是你自己控制的信箱，
# 避免防護失效時密碼重設信寄到第三方。
DEMO_EMAIL=
# DEMO_PASSWORD：Demo 帳戶的密碼，必須是長隨機值（至少 32 字元），產生方式同 SUPABASE_WEBHOOK_SECRET：
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DEMO_PASSWORD=
# DEMO_RATE_LIMIT_SECRET：一鍵進入限流用的 IP 雜湊金鑰（HMAC），長隨機值，
# 與 SUPABASE_WEBHOOK_SECRET、CRON_SECRET、DEMO_PASSWORD 都不同。
DEMO_RATE_LIMIT_SECRET=
# DEMO_RESET_ENABLED：每日**排程**還原的總開關，只有 "true" 才讓排程真的動資料，預設關閉。
# 手動還原（需 CRON_SECRET 與明確確認參數）不受此旗標約束。首次真實還原驗證成功後才開。
DEMO_RESET_ENABLED=false
